{
  "name": "devproductivitytracker",
  "displayName": "Dev Productivity Tracker",
  "description": "Track developer productivity metrics and view selected code",
  "publisher": "mandourilyass",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:devproductivitytracker.showSelectedCode",
    "onCommand:devproductivitytracker.generateCode",
    "onUri:vscode://mandourilyass.devtproductivitytracker*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devproductivitytracker.generateTests",
        "title": "Generate Unit Tests",
        "category": "Dev Productivity"
      },
      {
        "command": "devproductivitytracker.generateCode",
        "title": "Generate Code with AI",
        "category": "Dev Productivity"
      },
      {
        "command": "devproductivitytracker.showSelectedCode",
        "title": "Solve Your Coding Errors",
        "category": "Dev Productivity"
      },
      {
        "command": "devproductivitytracker.login",
        "title": "Login",
        "category": "Dev Productivity"
      },
      {
        "command": "devproductivitytracker.logout",
        "title": "Logout",
        "category": "Dev Productivity"
      },
      {
        "command": "devproductivitytracker.countErrors",
        "title": "Count Errors",
        "category": "Dev Productivity"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "devproductivitytracker.generateTests",
          "group": "2_generation",
          "when": "editorTextFocus"
        },
        {
          "command": "devproductivitytracker.generateCode",
          "group": "navigation",
          "when": "editorHasSelection"
        },
        {
          "command": "devproductivitytracker.showSelectedCode",
          "group": "navigation",
          "when": "editorHasSelection"
        },
        {
          "submenu": "devproductivitytracker.menu",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ],
      "editor/title": [
        {
          "command": "devproductivitytracker.showSelectedCode",
          "group": "navigation",
          "when": "editorHasSelection"
        }
      ],
      "commandPalette": [
        {
          "command": "devproductivitytracker.generateCode",
          "when": "editorTextFocus"
        }
      ],
      "devproductivitytracker.menu": [
        {
          "command": "devproductivitytracker.generateTests",
          "group": "1_analysis"
        },
        {
          "command": "devproductivitytracker.showSelectedCode",
          "group": "1_analysis"
        },
        {
          "command": "devproductivitytracker.generateCode",
          "group": "2_generation"
        },
        {
          "command": "devproductivitytracker.countErrors",
          "group": "3_analysis"
        }
      ]
    },
    "submenus": [
      {
        "id": "devproductivitytracker.menu",
        "label": "Dev Productivity",
        "icon": "$(sparkle)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@types/node-fetch": "^2.6.12",
    "node-fetch": "^3.3.2",
    "sync-request": "^6.1.0",
    "zod": "^3.22.4"
  },
  "icon": "images/icon.png",
  "keywords": [
    "productivity",
    "code",
    "tracker",
    "metrics",
    "AI",
    "code generation"
  ],
  "license": "MIT"
}